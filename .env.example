# APN Hub's public catalog works without environment variables.
# The suggestion handler uses this Formspree endpoint by default; set it only
# when routing production suggestions to a different Formspree form.
FORMSPREE_SUGGESTION_ENDPOINT=https://formspree.io/f/mjgqjoek

# Optional Cloudflare Turnstile. Configure both values together to require a
# final-submission verification challenge on /submit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Private agent workflow. Set secrets in the Functions scope only on Netlify.
# Never prefix a private credential with NEXT_PUBLIC_.
OPENAI_API_KEY=
APN_OWNER_TOKEN=
# Optional separate worker credential; defaults to APN_OWNER_TOKEN.
APN_WORKER_TOKEN=
APN_AGENTS_ENABLED=false
APN_DISCOVERY_ENABLED=false
APN_PUBLISH_ENABLED=false
APN_AGENT_MODEL=gpt-6-astra
APN_DAILY_BUDGET_USD=1
# Needed only for a model absent from the dated built-in price table:
# APN_INPUT_USD_PER_M=
# APN_OUTPUT_USD_PER_M=

# Direct read-only Search Console API authorization, after domain verification.
GSC_PROPERTY=sc-domain:apostolicpowernetwork.com
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Separate repository-scoped Contents write credential. No automatic provisioning.
APN_GITHUB_TOKEN=
APN_GITHUB_REPOSITORY=J-Rod98/APN-Hub
# Set this only after the owner reviews the content publication destination.
APN_PUBLISH_BRANCH=
# Pin the existing production store explicitly; do not rename a populated store.
# Preview deployments require their own store name or DEPLOY_ID.
# APN_STORE_NAME=

# Local verification only; never set these in production:
# APN_LOCAL_STATE=.agent-data/state.json
# APN_LOCAL_PUBLISH_DIR=.agent-data/publish-verification

# Invite-only Identity owner email; never a public NEXT_PUBLIC variable.
APN_IDENTITY_OWNER_EMAIL=
# Temporary, one-time migration switch; disable immediately after import.
APN_INITIAL_IMPORT_ENABLED=false

# Dedicated APN service account; production Functions secret only.
GSC_SERVICE_ACCOUNT_JSON=
