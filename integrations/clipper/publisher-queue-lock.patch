@@ -300,6 +305,34 @@
 # Queue
 # ---------------------------------------------------------------------------
 
+
+_QUEUE_MUTEX = threading.RLock()
+_QUEUE_DEPTH = threading.local()
+
+@contextlib.contextmanager
+def queue_transaction():
+    """Serialize entire read/modify/write operations across threads/processes."""
+    with _QUEUE_MUTEX:
+        if getattr(_QUEUE_DEPTH, "value", 0):
+            yield
+            return
+        DATA.mkdir(parents=True, exist_ok=True)
+        with (DATA / "queue-transaction.lock").open("a+") as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            _QUEUE_DEPTH.value = 1
+            try:
+                yield
+            finally:
+                _QUEUE_DEPTH.value = 0
+                fcntl.flock(handle, fcntl.LOCK_UN)
+
+def _queue_transaction(fn):
+    @functools.wraps(fn)
+    def wrapped(*args, **kwargs):
+        with queue_transaction():
+            return fn(*args, **kwargs)
+    return wrapped
+
